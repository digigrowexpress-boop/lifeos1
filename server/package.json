{
  "name": "lifeos-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "admin:create": "node --env-file-if-exists=.env src/scripts/admin.js create",
    "admin:reset-password": "node --env-file-if-exists=.env src/scripts/admin.js reset-password"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.3",
    "nodemailer": "^10.0.13"
  },
  "engines": {
    "node": ">=22.9"
  }
}
