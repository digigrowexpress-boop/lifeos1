# ---------------------------------------------------------------------------
# Database — MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Replace <db_username> and <db_password> INCLUDING the < > brackets.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/lifeos?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Sessions — long random secret used to protect login sessions (min 32 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (JWT_SECRET from older setups is still accepted.)
SESSION_SECRET=change-me-to-a-long-random-string
# How many days a login stays valid without activity (sliding window)
SESSION_DAYS=14

# ---------------------------------------------------------------------------
# Administrator — the single admin account is created from these values on
# startup (never through signup). Use an email that is NOT a normal user account.
# Password: at least 12 characters with letters and numbers.
# After the first start you can delete ADMIN_PASSWORD; it is only used once.
# (Alternative: leave these empty and run `npm run admin:create`.)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true together with ADMIN_PASSWORD to reset a forgotten admin password
ADMIN_RESET_PASSWORD=false
# Where new-registration emails go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Email (admin notifications + approval emails to users). Any SMTP provider works.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-character App Password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LifeOS <no-reply@example.com>
# Development without SMTP: print emails to the terminal instead
# MAIL_TRANSPORT=console
# Set to false to stop emailing users when their request is approved/rejected
NOTIFY_USERS=true
# Public address of the web app, used for links in emails
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Server
PORT=4000
NODE_ENV=development
# Only when the web app is hosted on a different domain than the API:
# comma-separated allowed origins (enables cross-site session cookies).
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Optional: AI Coach (OpenAI). Leave OPENAI_API_KEY empty to disable it.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model to use (default: gpt-6-luna, OpenAI's cost-efficient model)
OPENAI_MODEL=gpt-6-luna
# Reasoning effort for reasoning models: none | low | medium | high (default: low)
OPENAI_REASONING_EFFORT=low
# Any OpenAI-compatible API works (e.g. OpenRouter, Groq, a local Ollama server)
OPENAI_BASE_URL=https://api.openai.com/v1
