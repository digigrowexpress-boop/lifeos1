# Base URL of the LifeOS API.
# Leave empty when the API serves the client (single deployment) or in local
# development (Vite proxies /api to http://localhost:4000).
# Set it when the client is hosted separately, e.g. on Vercel/Netlify:
#   VITE_API_URL=https://lifeos-api.onrender.com
VITE_API_URL=
