{
  "name": "lifeos",
  "version": "1.0.0",
  "private": true,
  "description": "LifeOS — personal academic, study, goal and lifestyle intelligence system.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "admin:create": "npm run admin:create -w server",
    "admin:reset-password": "npm run admin:reset-password -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
